{
  "name": "luma-green",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Luma.Green \u2014 Cleaner Tomorrow in Motion. Recycling inventory, sector trade and carbon credits in one place.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "lint": "next typegen && eslint .",
    "lint:fix": "next typegen && eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "auth:schema": "jiti scripts/generate-auth-schema.mts",
    "i18n:generate": "jiti scripts/generate-error-copy.mts && pnpm --filter @luma/mobile messages:generate",
    "screenshots": "jiti scripts/screenshots.mts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm apps:check",
    "prepare": "husky",
    "mobile:dev": "pnpm --filter @luma/mobile dev",
    "mobile:export": "pnpm --filter @luma/mobile export",
    "desktop:dev": "pnpm --filter @luma/desktop dev",
    "desktop:pack": "pnpm --filter @luma/desktop run pack",
    "apps:check": "pnpm --filter \"./apps/*\" check",
    "guide:check": "vitest run --config vitest.guide.config.mts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.1",
    "@astryxdesign/theme-matcha": "0.7.1",
    "@convex-dev/better-auth": "0.12.5",
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.74.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-query": "^5.103.2",
    "@trigger.dev/sdk": "^4.8.1",
    "aws4fetch": "1.0.20",
    "better-auth": "~1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "convex": "^1.46.0",
    "gsap": "3.15.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.4.3",
    "next-intl": "^4.14.7",
    "posthog-js": "^1.434.14",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@edge-runtime/vm": "^5.0.0",
    "@formatjs/icu-messageformat-parser": "^3.5.18",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "convex-test": "^0.0.62",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
