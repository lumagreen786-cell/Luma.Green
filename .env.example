# ---------------------------------------------------------------------------
# Luma.Green — environment template
#
# Copy to `.env.local` and fill in what you need. EVERY var here is optional:
# the app builds, tests and runs with an empty file. Some features need an
# explicit enable flag as well as keys. Follow their operation guides.
#
# Never commit `.env.local`. Public frontend/build settings belong in Vercel
# Production; operational provider secrets belong in Convex, not Vercel.
# Use local development for checks. Hosted Preview deployments are disabled.
# See docs/operations/environments.md for each setting's owner.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional HTML ownership tokens, content value only; no tracking script.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- Convex (database + server functions) ----------------------------------
# `npx convex dev` writes these for you on first run. The site URL is where
# HTTP actions (and sign-in) live: the same host with .convex.site.
NEXT_PUBLIC_CONVEX_URL=""
NEXT_PUBLIC_CONVEX_SITE_URL=""
CONVEX_DEPLOYMENT=""
# CI/CD only — from the Convex dashboard, Production > Deploy key.
CONVEX_DEPLOY_KEY=""

# --- Auth (Better Auth) ----------------------------------------------------
# Better Auth runs inside Convex, so its settings live on the Convex
# deployment, not here (docs/operations/environments.md):
#   npx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 32)"
#   npx convex env set SITE_URL http://localhost:3000
#   ADMIN_EMAIL: internal phone identity, e.g. 919876543210@phone.luma.green
#   Use the owner-approved admin phone. The legacy variable is not email login.
#   Admin signs in by SMS, then completes authenticator setup at /admin/setup.
# Local auth tests use a loopback Convex backend and the secured inbox below.
# AUTH_DEV_MODE does not enable OTP delivery; codes are never logged.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Optional telemetry (docs/operations/observability.md) -----------------
# Set true only in the intended deployment; rebuild after any public change.
# Blank/false disables PostHog, Google Analytics and Sentry, even with keys.
NEXT_PUBLIC_TELEMETRY_ENABLED=""

# --- Public-page analytics (PostHog and/or Google Analytics 4) --------------
# Also needs the visitor's explicit choice. Private workflows are excluded.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Format: G-XXXXXXXXXX. Disable Enhanced Measurement entirely in GA first.
# Do not install a second GA/GTM tag: the app sends manual page views.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Error tracking (Sentry) -----------------------------------------------
# Requires the enable flag above and a DSN. Independent of analytics choice.
# Errors only; traces, replay, logs and identifying event context are disabled.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# CI only — needed to upload source maps.
SENTRY_AUTH_TOKEN=""

# --- OTP (MSG91) -----------------------------------------------------------
# Set on the Convex deployment, once the provider templates are approved.
# .env.local does not configure deployed Convex functions.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# --- Status SMS (MSG91 Flow; Convex deployment only) -----------------------
# JSON: {"booking_confirmed":{"en":"approved-template-id"}, ...}
# Full event list and VAR1 contract: docs/operations/sms-notifications.md
MSG91_NOTIFICATION_TEMPLATES=""
SMS_NOTIFICATION_BASE_URL=""
# No language fallback unless explicitly enabled.
MSG91_NOTIFICATION_ENGLISH_FALLBACK=""

# --- Optional device push (Convex deployment only) -------------------------
# In-app inbox works without these. Keep private keys/access tokens in Convex.
# See docs/operations/push-notifications.md. Never use NEXT_PUBLIC for secrets.
WEB_PUSH_ENABLED=""
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""
EXPO_PUSH_ENABLED=""
EXPO_PUSH_ACCESS_TOKEN=""

# --- Optional photo estimates (server-side Convex settings) ----------------
# Blank keeps the existing OpenRouter adapter; self-hosted NEVER falls back to paid calls.
PHOTO_ESTIMATE_PROVIDER=""
# Self-hosted: full public HTTPS OpenAI-compatible /v1/chat/completions endpoint.
# Put Ollama behind an authenticated gateway; its local API does not enforce API keys.
# Convex cloud cannot reach localhost or a private router. No browser credentials.
PHOTO_ESTIMATE_ENDPOINT=""
PHOTO_ESTIMATE_API_KEY=""
# Operator must verify the selected vision model license and hardware latency.
PHOTO_ESTIMATE_MODEL=""
# Set a hard spending limit on the key before using it anywhere but locally.
OPENROUTER_API_KEY=""
# Set on Convex. Choose a vision model with strict structured output support.
OPENROUTER_MODEL=""

# Private paper features remain off without separate approved daily budgets.
PAPER_TRANSCRIPTION_ENABLED=false
PAPER_TRANSCRIPTION_DAILY_LIMIT=""
PAPER_ASSISTANCE_ENABLED=false
PAPER_ASSISTANCE_DAILY_LIMIT=""

# Future verified subscription evidence only; a flag never grants paid access.
# Leave off until the recurring provider producer and policy are accepted.
BUSINESS_SUBSCRIPTIONS_ENFORCEMENT_ENABLED=false
# Rolling 24-hour global cap; 1–1000, default 100. Failed calls consume quota.
PHOTO_ESTIMATE_DAILY_LIMIT="100"

# Email/password authentication and admin password recovery are disabled.

# --- Optional industry news (Convex deployment only) -----------------------
# NewsAPI production use needs a suitable provider plan and content rights.
# No requests without explicit enablement. No automatic retry or paid fallback.
INDUSTRY_NEWS_ENABLED=""
INDUSTRY_NEWS_API_KEY=""
# Hard global 24-hour window provider cap; failed requests consume quota too.
INDUSTRY_NEWS_DAILY_LIMIT="100"

# --- Public area data (Convex deployment only) -----------------------------
# Off by default. Read docs/operations/public-data.md before enabling.
PUBLIC_DATA_ENABLED="false"
MET_NORWAY_USER_AGENT=""
DATA_GOV_IN_API_KEY=""
DATA_GOV_IN_AIR_RESOURCE_ID=""

# Optional workspace email delivery (Convex only; not login or recovery).
# RESEND_API_KEY requires a provider-verified sender.
# AUTH_FROM_EMAIL=accounts@example.com
# SITE_URL=https://your-site.example

# Strictly local test delivery. Never copy these into hosted environments.
# Both SITE_URL and system CONVEX_SITE_URL must be loopback HTTP URLs.
# AUTH_LOCAL_TEST_MODE=true
# AUTH_LOCAL_EMAIL_INBOX_URL=http://127.0.0.1:3215/deliver
# AUTH_LOCAL_EMAIL_INBOX_TOKEN=<private-random-token-of-at-least-32-characters>
# See scripts/local-auth/README.md. No browser flag enables this path.

# --- B2B payments (Convex only) -------------------------------------------
# Selected provider: Cashfree Payment Gateway + Easy Split.
# Off by default. Sandbox and live checkout require separate explicit opt-in.
# Live checkout also requires an approved policy and verified seller setup.
# Existing-order reconciliation and approved refunds remain available when new checkout is paused.
# Never reuse sandbox keys for live mode or expose keys with NEXT_PUBLIC_.
# See docs/architecture/payments.md and the launch checklist before setup.
CASHFREE_MODE="off"
CASHFREE_SANDBOX_CLIENT_ID=""
CASHFREE_SANDBOX_CLIENT_SECRET=""
CASHFREE_LIVE_CLIENT_ID=""
CASHFREE_LIVE_CLIENT_SECRET=""
CASHFREE_SANDBOX_CHECKOUT_ENABLED="false"

# Live checkout is off until provider acceptance and an immutable approved policy.
CASHFREE_LIVE_CHECKOUT_ENABLED="false"
CASHFREE_LIVE_POLICY_VERSION=""
# --- OTP (OS Digital; set in the Convex deployment) -------------------------
# All five values are required together. Partial settings disable SMS.
# Use the exact approved DLT message, with one {#var#} placeholder for the code.
# Selected sender: ENVRIN. Verify both DLT IDs in the provider dashboard.
OSDIGITAL_API_KEY=""
OSDIGITAL_SENDER_ID=""
OSDIGITAL_ENTITY_ID=""
OSDIGITAL_TEMPLATE_ID=""
OSDIGITAL_OTP_MESSAGE=""

# --- Turnstile OTP protection ---------------------------------------------
# Public site key: Next.js/Vercel build setting. Create an INVISIBLE widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Set these three only on the matching Convex deployment. See the runbook.
TURNSTILE_ENABLED="false"
TURNSTILE_SECRET_KEY=""
TURNSTILE_HOSTNAMES=""
# docs/operations/turnstile.md: deploy both sides, then enable enforcement.

# R2 quality attachments — Convex deployment settings only; optional/off by default.
# Keep credentials available for existing R2 reads when disabling new writes.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Surepass PAN/GST — set on each Convex deployment only, never Vercel.
# Development stays off to preserve the shared paid production allowance.
SUREPASS_API_TOKEN=""
SUREPASS_ENABLED="false"
# Hard limit: 20 attempts across PAN/GST per India calendar day, no retries.

# Private report jobs: Convex-only dispatch key; off until Trigger task is deployed.
TRIGGER_JOBS_ENABLED=false
TRIGGER_SECRET_KEY=
# Trigger runtime/CLI only. Never use a Convex admin key.
TRIGGER_PROJECT_REF=
TRIGGER_CONVEX_URL=

# Optional Google geocoding. Configure operational credentials only in Convex.
GOOGLE_GEOCODING_ENABLED=false
GOOGLE_GEOCODING_API_KEY=
# Enable address saving only after reviewing Google content storage policy.
GOOGLE_GEOCODING_ADDRESS_SAVE_ENABLED=false
