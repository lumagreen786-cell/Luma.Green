{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://luma.green",
        "EXPO_PUBLIC_PUSH_ENABLED": "false"
      },
      "node": "24.18.0",
      "pnpm": "11.24.0"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk",
        "image": "sdk-57"
      },
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://luma.green",
        "EXPO_PUBLIC_PUSH_ENABLED": "false"
      },
      "node": "24.18.0",
      "pnpm": "11.24.0",
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_URL": "https://luma.green",
        "EXPO_PUBLIC_PUSH_ENABLED": "false"
      },
      "node": "24.18.0",
      "pnpm": "11.24.0"
    }
  },
  "submit": {
    "production": {}
  }
}
