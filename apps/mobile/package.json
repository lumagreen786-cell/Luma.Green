{
  "name": "@luma/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.cjs test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "export": "expo export --platform all",
    "messages:generate": "node scripts/generate-messages.cjs",
    "demo:ios": "node scripts/demo.cjs ios",
    "demo:android": "node scripts/demo.cjs android",
    "demo:device": "node scripts/demo.cjs device"
  },
  "dependencies": {
    "expo": "57.0.30",
    "expo-constants": "57.0.22",
    "expo-dev-client": "57.0.20",
    "expo-localization": "57.0.2",
    "expo-location": "57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "^6.0.3"
  }
}
