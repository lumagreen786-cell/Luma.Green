# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/tmp/pdfs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env — .env.example is the one file we DO commit
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# convex
.convex/

# sentry
.sentryclirc
.env.sentry-build-plugin

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Mobile build output (source lives in apps/mobile).
ios/build/
ios/Pods/
android/build/
android/.gradle/
*.ipa
*.apk
*.aab

# Native shells: generated projects, app bundles and release credentials.
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/ios/
apps/mobile/android/
apps/desktop/dist/
apps/desktop/release/
apps/desktop/generated/
*.p12
*.pfx
*.keystore
*.jks
*.mobileprovision
apps/mobile/google-services.json
apps/mobile/*service-account*.json

# os
Thumbs.db

# Local guide tooling
/.venv-guide/
__pycache__/

# Hosted web imagery and delivery artifacts are not embedded in the Android shell.
/docs/
/e2e/
/e2e-analytics/
/.agents/
/.claude/
/.codex/
/.github/
/public/*
!/public/brand
!/public/brand/**
/captures/
/android/
/ios/
/e2e-turnstile/
