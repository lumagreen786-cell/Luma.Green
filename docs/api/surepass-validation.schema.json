{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GST lookup and confirmation Convex contracts",
  "$defs": {
    "lookupGstArgs": {
      "type": "object",
      "required": ["applicationId", "consent"],
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        },
        "consent": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "lookupGstResult": {
      "type": "object",
      "required": ["gstin", "businessName", "legalName", "address"],
      "properties": {
        "gstin": {
          "type": "string",
          "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    },
    "confirmGstArgs": {
      "type": "object",
      "required": ["applicationId", "gstin"],
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        },
        "gstin": {
          "type": "string",
          "minLength": 15,
          "maxLength": 15
        }
      },
      "additionalProperties": false
    },
    "confirmationResult": {
      "type": "null"
    },
    "errorCode": {
      "enum": [
        "VALIDATION_REQUIRED",
        "CHECK_UNAVAILABLE",
        "CHECK_LIMIT",
        "CHECK_PENDING"
      ]
    },
    "gstArgs": {
      "type": "object",
      "required": ["applicationId"],
      "properties": {
        "applicationId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "gstResult": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "gstin",
            "businessName",
            "legalName",
            "address",
            "confirmed"
          ],
          "properties": {
            "gstin": {
              "type": "string",
              "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
            },
            "businessName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "legalName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "confirmed": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
